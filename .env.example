# Firebase Web App Credentials
# Obtain these from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=AIzaSyExampleKey123456789
VITE_FIREBASE_AUTH_DOMAIN=hostel-shop-inventory.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hostel-shop-inventory
VITE_FIREBASE_STORAGE_BUCKET=hostel-shop-inventory.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Optional: Cloud Functions API Base URL
# Leave empty to use direct Firestore mode (zero billing, Spark-plan friendly)
# Or set to http://127.0.0.1:5001/YOUR_PROJECT_ID/us-central1/api when using emulator
# Or https://us-central1-YOUR_PROJECT_ID.cloudfunctions.net/api in production with Blaze
VITE_API_BASE_URL=
